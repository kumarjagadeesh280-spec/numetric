{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/founder", "destination": "/team", "permanent": true }
  ],
  "rewrites": [
    { "source": "/blog/:slug", "destination": "/post.html" },
    { "source": "/admin", "destination": "/studio.html" },
    { "source": "/erp", "destination": "https://inventory-tool-eight.vercel.app" },
    { "source": "/erp/:path*", "destination": "https://inventory-tool-eight.vercel.app/:path*" }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
